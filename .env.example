# Database
DATABASE_URL=postgresql://user:password@host:port/database
REDIS_URL=redis://redis-host:port

# better-auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# LibreTranslate (using free hosted version)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=api-key
GCP_TRANSLATE_API_KEY=api-key

# Google Cloud Services
# Place your service account JSON file at: secrets/lang-481909-7416a55f8e8d.json
# This file is used for:
# - Text-to-Speech (TTS) API
# - Vision/OCR API (text extraction from images)
#
# To create a service account:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Create a project or select existing project
# 3. Enable APIs:
#    - Cloud Text-to-Speech API
#    - Cloud Vision API
# 4. Create a service account with appropriate roles
# 5. Download the JSON key file
# 6. Rename it to: lang-481909-7416a55f8e8d.json
# 7. Place it in the secrets/ directory